      "title": "1998 startup batch file",
      "path": "sams-calendar-program-1/B.BAT",
      "text": "gwbasic clean"
    },
    {
      "title": "Earlier startup batch file",
      "path": "sams-calendar-program/B.BAT",
      "text": "@echo off\ngwbasic clean"
    },
    {
      "title": "Hex arithmetic batch file",
      "path": "sams-calendar-program/HEX.BAT",
      "text": "ECHO OFF\nIF !%2==! GOTO OOPS\nECHO H %1 %2 > DEBUG.SCR\nECHO Q >> DEBUG.SCR\nECHO The sum and difference of %1 and %2 are:\ndebug < debug.scr | find /v \"-\"\nDEL DEBUG.SCR\nGOTO END\n:OOPS\nECHO You have to enter %0 followed by\nECHO 2 hex numbers each FFFF or less\nECHO (e.g.%0 4D7F 5A4)\nEND"
    }
  ],
